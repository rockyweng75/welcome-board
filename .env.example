# APP_URL: The URL where this app is hosted.
APP_URL="MY_APP_URL"

# 伺服器配置
NODE_ENV=production
PORT=8080

# 認證配置 - 選擇使用環境變數認證或 DB2 認證
# VITE_AUTH_TYPE=env     # 默認: 使用環境變數認證
# VITE_AUTH_TYPE=db2     # 使用 DB2 認證

# 環境變數認證 (當 VITE_AUTH_TYPE=env 時使用)
VITE_ADMIN_USER=admin
VITE_ADMIN_PASS=admin123

# DB2 連線配置 (當 VITE_AUTH_TYPE=db2 時使用)
# 選項 1: 使用 ODBC 連線字符串
# DB2_CONN_STRING=DRIVER={IBM i Access ODBC Driver};SYSTEM=your-ibm-host;UID=your-user;PWD=your-password

# 選項 2: 使用個別的連線參數 (應用會自動組合連線字符串)
# DB2_HOST=your-ibm-host
# 用戶名和密碼由登入表單提供

# 其他 DB2 配置 (可選)
# DB2_PORT=446              # 默認 IBM i ODBC 端口
# DB2_DATABASE=*LOCAL       # 默認本地數據庫
# DB2_PROTOCOL=TCPIP        # 通信協議
